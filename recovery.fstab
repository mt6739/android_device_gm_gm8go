
/recovery	    emmc	/dev/block/platform/bootdevice/by-name/recovery         flags=display="Recovery";backup=1

/boot		    emmc	/dev/block/platform/bootdevice/by-name/boot             flags=display="Boot";backup=1

/system		    ext4	/dev/block/platform/bootdevice/by-name/system		flags=display="System";backup=1;wipeingui

/system_image       emmc	/dev/block/platform/bootdevice/by-name/system		flags=flashimg=1

/cache		    ext4	/dev/block/platform/bootdevice/by-name/cache

/data		    f2fs	/dev/block/platform/bootdevice/by-name/userdata         flags=encryptable=/dev/block/platform/bootdevice/by-name/metadata

/vendor             ext4        /dev/block/platform/bootdevice/by-name/vendor		flags=display="Vendor";backup=1;wipeingui

/vendor_image	    emmc	/dev/block/platform/bootdevice/by-name/vendor		flags=flashimg=1

/external_sd        auto	/dev/block/mmcblk1p1	   /dev/block/mmcblk1               flags=display="External SDcard";storage;wipeingui;removable

/usbotg		    auto        /dev/block/sda1           /dev/block/sda	                   flags=display="Usb-Otg";storage;removable;wipeingui

/vendor/protect_f             ext4        /dev/block/platform/bootdevice/by-name/protect1		flags=display="protect1";backup=1
/vendor/protect_s             ext4        /dev/block/platform/bootdevice/by-name/protect2		flags=display="protect2";backup=1
/vendor/nvdata             ext4        /dev/block/platform/bootdevice/by-name/nvdata		flags=display="nvdata";backup=1
/vendor/nvcfg             ext4        /dev/block/platform/bootdevice/by-name/nvcfg		flags=display="nvcfg";backup=1
/persistent             emmc        /dev/block/platform/bootdevice/by-name/frp		flags=display="frp";backup=1
/nvram             emmc        /dev/block/platform/bootdevice/by-name/nvram		flags=display="nvram";backup=1
/proinfo             emmc        /dev/block/platform/bootdevice/by-name/proinfo		flags=display="proinfo";backup=1
/lk             emmc        /dev/block/platform/bootdevice/by-name/lk		flags=display="lk";backup=1
/lk2             emmc        /dev/block/platform/bootdevice/by-name/lk2		flags=display="lk2";backup=1;subpartitionof=/lk
/para             emmc        /dev/block/platform/bootdevice/by-name/para		flags=display="para";backup=1
/logo             emmc        /dev/block/platform/bootdevice/by-name/logo		flags=display="logo";backup=1
/exdp             emmc        /dev/block/platform/bootdevice/by-name/exdp		flags=display="exdp";backup=1
/seccfg             emmc        /dev/block/platform/bootdevice/by-name/seccfg		flags=display="seccfg";backup=1
/tee1             emmc        /dev/block/platform/bootdevice/by-name/tee1		flags=display="tee1";backup=1
/tee2             emmc        /dev/block/platform/bootdevice/by-name/tee2		flags=display="tee2";backup=1
/md1img             emmc        /dev/block/platform/bootdevice/by-name/md1img		flags=display="md1img";backup=1
/md1dsp             emmc        /dev/block/platform/bootdevice/by-name/md1dsp		flags=display="md1dsp";backup=1
/md1arm7             emmc        /dev/block/platform/bootdevice/by-name/md1arm7		flags=display="md1arm7";backup=1
/md3img             emmc        /dev/block/platform/bootdevice/by-name/md3img		flags=display="md3img";backup=1

